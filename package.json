{
  "name": "ifc-mcp",
  "version": "0.3.1",
  "description": "Local MCP server for IFC/BIM workflows with generated IfcOpenShell Python in Pyodide and an IFC viewer.",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./browser": "./dist/browser.js",
    "./results": {
      "types": "./dist/tool-results.d.ts",
      "default": "./dist/tool-results.js"
    }
  },
  "bin": {
    "ifc-mcp": "dist/ifc-mcp.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES",
    "vendor/ifcopenshell/single-thread-clash.patch",
    "vendor/ifcopenshell/licenses/",
    "vendor/pyodide/LICENSE",
    "docs/ifc-mcp-demo-thumbnail.jpg",
    "dist/browser.js",
    "dist/ifc-mcp.js",
    "dist/server.js",
    "dist/python-worker-node.mjs",
    "dist/python-worker-browser.js",
    "dist/python/",
    "dist/sandbox/",
    "dist/tool-results.js",
    "dist/tool-results.d.ts",
    "dist/static/"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "sync-metadata": "node scripts/sync-server-metadata.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "start": "node ./bin/ifc-mcp.js",
    "test": "node --test --test-concurrency=1 tests-node/python-runtime.test.mjs tests-node/ifc-mcp.test.mjs tests-node/viewer-lifecycle.test.mjs tests-node/viewer-http.test.mjs tests-node/benchmark-source.test.mjs tests-node/stdio-resilience.test.mjs tests-node/downloads.test.mjs tests-node/mcp-tools.test.mjs tests-node/browser-host.test.mjs tests-node/bcf-colors.test.mjs tests-node/tool-results.test.mjs tests-node/protocol.test.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:installed": "node scripts/test-installed-package.mjs",
    "test:prompts": "node --test --test-concurrency=1 tests-node/prompts.eval.mjs",
    "benchmark:ifcopenshell": "node scripts/benchmark-ifcopenshell.mjs",
    "check:wasm": "node scripts/check-ifcopenshell-wasm.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ifc",
    "ifcopenshell",
    "ifc-viewer",
    "pyodide",
    "bim",
    "building-information-modeling",
    "openbim",
    "bcf"
  ],
  "author": "Flinker GmbH",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flinker-app/ifc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/flinker-app/ifc-mcp/issues"
  },
  "homepage": "https://github.com/flinker-app/ifc-mcp#readme",
  "mcpName": "io.github.flinker-app/ifc-mcp",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "1.63.0",
    "esbuild": "^0.28.1",
    "pyodide": "0.28.3"
  }
}
